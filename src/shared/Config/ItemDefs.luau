--!strict
-- Every item in the game. Weight is in kilograms. Icons are text glyphs until an artist
-- provides image assets (see docs/ASSET_SPECS.md); UI reads `glyph` and `color` only.

export type Region = "Head" | "Torso" | "Hands" | "Legs" | "Feet"
export type Category = "Food" | "Drink" | "Tool" | "Medical" | "Material" | "Clothing" | "Backpack"
export type ClothingSlot = "Head" | "Face" | "BaseLayer" | "Jacket" | "Gloves" | "Pants" | "Boots"

export type ClothingStats = {
	slot: ClothingSlot,
	insulation: { [Region]: number }, -- insulation points per covered region
	windproof: number, -- 0..1, fraction of wind blocked on covered regions
	waterproof: number, -- 0..1, fraction of precipitation shed on covered regions
	wetPenalty: number, -- 0..1, fraction of insulation lost when fully soaked
	mobility: number, -- multiplier applied to climb speed (1 = unrestricted)
	color: Color3,
}

export type BackpackStats = {
	tier: "Small" | "Medium" | "Large" | "Expedition",
	slots: number,
	weightLimit: number,
	color: Color3,
}

export type UseEffect = {
	hunger: number?,
	thirst: number?,
	stamina: number?,
	fatigue: number?,
	health: number?,
	warmthAll: number?,
	warmthRegion: { [Region]: number }?,
	treats: { string }?,
	buff: { id: string, duration: number }?,
}

export type ContainerStats = {
	capacityMl: number,
	sipMl: number,
	thirstPerSip: number,
	keepsHot: boolean,
}

export type ItemDef = {
	id: string,
	name: string,
	category: Category,
	weight: number,
	maxStack: number,
	description: string,
	glyph: string,
	color: Color3,
	unlockRank: number, -- index into ProgressionConfig.Ranks; 1 = available from the start
	use: UseEffect?,
	consumable: boolean?,
	clothing: ClothingStats?,
	backpack: BackpackStats?,
	container: ContainerStats?,
	holdable: boolean?, -- can be held in hand (ice axe)
	durability: number?, -- uses for tools such as the lighter
	cookedInto: string?, -- item produced when cooked at a fire
	treatOther: boolean?, -- can be applied to a teammate
}

