local byId: { [string]: ItemDef } = {}
for _, def in list do
	assert(byId[def.id] == nil, "duplicate item id " .. def.id)
	byId[def.id] = def
end

local ItemDefs = {
	List = list,
	ById = byId,
	-- Water is weighed separately from the container: 1 ml = 1 g.
	WATER_KG_PER_ML = 0.001,
}

function ItemDefs.get(id: string): ItemDef?
	return byId[id]
end

return ItemDefs
